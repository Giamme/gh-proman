#!/usr/bin/env python3
"""Install the gh-proman skill from a clone, for agents other than Claude Code, and the `gh-proman` command.

Claude Code gets the skill (and its sync hook) from the plugin instead:
    /plugin marketplace add Giamme/gh-proman
    /plugin install gh-proman@gh-proman

Without a clone, `npx skills add Giamme/gh-proman` installs the skill for most agents.

This script symlinks skills/gh-proman into each selected agent's skill directory, so a `git pull` updates
every agent, and links ~/.local/bin/gh-proman to the CLI. For Codex it also registers the PostToolUse sync
hook in $CODEX_HOME/hooks.json (skip with --no-hooks; Codex asks you to trust it on first run). Installing the
Codex plugin instead (`codex plugin marketplace add Giamme/gh-proman`) brings the same hook.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
SKILL = REPO / "skills" / "gh-proman"
CLI = SKILL / "scripts" / "gh_proman.py"
NAME = "gh-proman"

# name: (env var overriding the base, default base relative to $HOME, suffix under the base, detection dir)
CLIENTS = {
    "codex": ("CODEX_HOME", ".codex", ("skills",), ".codex"),
    "openclaude": ("OPENCLAUDE_HOME", ".openclaude", ("skills",), ".openclaude"),
    "opencode": ("XDG_CONFIG_HOME", ".config", ("opencode", "skills"), ".config/opencode"),
    "kimi": ("KIMI_CODE_HOME", ".kimi-code", ("skills",), ".kimi-code"),
    "antigravity-cli": (None, ".gemini", ("antigravity-cli", "skills"), ".gemini/antigravity-cli"),
    "antigravity-ide": (None, ".gemini", ("config", "skills"), ".gemini/config"),
    "agents": (None, ".agents", ("skills",), None),  # shared ~/.agents/skills; opt-in, some agents also read it
}


def destination(name: str) -> Path:
    env, base, suffix, _ = CLIENTS[name]
    home = Path.home()
    root = Path(os.environ[env]) if env and os.environ.get(env) else home / base
    return root.joinpath(*suffix) / NAME


def detected() -> list:
    home = Path.home()
    names = []
    for name, (env, _, _, probe) in CLIENTS.items():
        if (env and os.environ.get(env) and name != "opencode") or (probe and (home / probe).is_dir()):
            names.append(name)
    return names


def ours(path: Path, target: Path) -> bool:
    return path.is_symlink() and Path(os.readlink(path)).resolve() == target.resolve()


def link(path: Path, target: Path, dry_run: bool, force: bool) -> str:
    if ours(path, target):
        return f"ok        {path}"
    if path.exists() or path.is_symlink():
        if not force:
            return f"conflict  {path} exists and is not ours (use --force to replace)"
        if not dry_run:
            shutil.rmtree(path) if path.is_dir() and not path.is_symlink() else path.unlink()
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)
    return f"{'would link' if dry_run else 'linked':<9} {path} -> {target}"


def unlink(path: Path, target: Path, dry_run: bool) -> str:
    if not ours(path, target):
        return f"skip      {path} (not installed by this repo)"
    if not dry_run:
        path.unlink()
    return f"{'would remove' if dry_run else 'removed':<9} {path}"


HOOK = SKILL / "scripts" / "hook.py"
HOOK_MATCHERS = ("Bash", "mcp__.*(create_issue|issue_write|create_pull_request|merge_pull_request)")


def codex_hooks_path() -> Path:
    base = Path(os.environ["CODEX_HOME"]) if os.environ.get("CODEX_HOME") else Path.home() / ".codex"
    return base / "hooks.json"


def codex_hooks(uninstall: bool, dry_run: bool) -> str:
    """Add (or remove) our PostToolUse entries in Codex's hooks.json, leaving every other hook untouched."""
    path = codex_hooks_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
    except (OSError, ValueError):
        return f"skip      {path} is not valid JSON; add the hook by hand (see README)"
    command = f'python3 "{HOOK}"'
    post = data.setdefault("hooks", {}).setdefault("PostToolUse", [])
    kept = [m for m in post if not any(str(HOOK) in h.get("command", "") for h in m.get("hooks", []))]
    if uninstall:
        if len(kept) == len(post):
            return f"skip      {path} (no gh-proman hook)"
        data["hooks"]["PostToolUse"] = kept
        verb = "would remove" if dry_run else "removed"
    else:
        if len(kept) == len(post) - len(HOOK_MATCHERS):
            return f"ok        {path}"
        data["hooks"]["PostToolUse"] = kept + [
            {"matcher": m, "hooks": [{"type": "command", "command": command, "timeout": 15,
                                      "statusMessage": "gh-proman sync check"}]} for m in HOOK_MATCHERS]
        verb = "would add" if dry_run else "added"
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    return f"{verb:<9} sync hook in {path}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--client", action="append", choices=[*CLIENTS, "all"],
                        help="agent to install for (repeatable; default: every detected agent)")
    parser.add_argument("--no-shim", action="store_true", help="do not create ~/.local/bin/gh-proman")
    parser.add_argument("--no-hooks", action="store_true", help="do not register the Codex sync hook")
    parser.add_argument("--uninstall", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--force", action="store_true", help="replace an existing non-symlink install")
    args = parser.parse_args()

    names = list(CLIENTS) if args.client and "all" in args.client else (args.client or detected())
    lines = []
    for name in names:
        path = destination(name)
        lines.append(f"{name:<16}" + (unlink(path, SKILL, args.dry_run) if args.uninstall
                                       else link(path, SKILL, args.dry_run, args.force)))
    if "codex" in names and not args.no_hooks:
        lines.append(f"{'codex hook':<16}" + codex_hooks(args.uninstall, args.dry_run))
    if not args.no_shim:
        shim = Path.home() / ".local" / "bin" / "gh-proman"
        if args.uninstall:
            lines.append(f"{'command':<16}" + unlink(shim, CLI, args.dry_run))
        else:
            if not args.dry_run:
                CLI.chmod(CLI.stat().st_mode | 0o111)
            lines.append(f"{'command':<16}" + link(shim, CLI, args.dry_run, args.force))
            if str(shim.parent) not in os.environ.get("PATH", "").split(os.pathsep):
                lines.append(f"{'':<16}note: {shim.parent} is not on PATH; add it to run `gh-proman` yourself")

    claude_copy = Path.home() / ".claude" / "skills" / NAME
    if claude_copy.exists() or claude_copy.is_symlink():
        lines.append(f"warning: {claude_copy} exists; with the plugin installed Claude Code would list the skill "
                     "twice. Remove it and use the plugin.")
    if not args.uninstall:
        lines += ["", "Claude Code: install the plugin (skill + sync hook):",
                  "  /plugin marketplace add Giamme/gh-proman", "  /plugin install gh-proman@gh-proman"]
    print("\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main())
